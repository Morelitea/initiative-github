# The shared secret this app's registration was wired with.
INITIATIVE_APP_SECRET=

# The deployment this app serves: where its verification keys come from, and
# the only origin allowed to frame this app's pages.
INITIATIVE_BASE_URL=https://initiative.example.com

# Where this app is reachable, for building the OAuth callback.
APP_PUBLIC_URL=https://github-app.example.com

# A GitHub OAuth app. Read-only scopes; this app holds no write credential.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
