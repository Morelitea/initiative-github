# ── Required ────────────────────────────────────────────────────────────────

# The shared secret this app's registration was wired with.
INITIATIVE_APP_SECRET=

# Server-to-server: where THIS SERVER reaches Initiative, to fetch the
# verification keys a context token is checked against. In a cluster this is the
# in-cluster Service, so verification never depends on the public ingress.
INITIATIVE_BASE_URL=http://initiative:8000

# Browser-facing: where a PERSON'S BROWSER reaches this app. Every URL on the
# GitHub App registration is built from it — the callback, the setup URL and the
# webhook — so it must be publicly resolvable and must match what you registered.
#   npm run github-app   prints them all for this value
APP_PUBLIC_URL=https://github-app.example.com

# Members' credentials and in-flight vendor handshakes. Not optional: a process
# without one drops every connection on restart and cannot run two replicas.
DATABASE_URL=postgres://user:password@localhost:5432/initiative_github

# Seals members' credentials at rest, so a database backup is not a pile of
# GitHub tokens. Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── The GitHub App ──────────────────────────────────────────────────────────
# All four come from ONE registration you create at GitHub, which is a separate
# thing from the Initiative listing:
#   https://github.com/settings/apps/new
# Run `npm run github-app` first — it prints every field to fill in, and writes
# github-app.json for the manifest flow if you would rather not type them.

# The app's client id. It identifies the app in the member's connect flow and is
# also what the app signs its own JWT as, so there is no separate app id here.
GITHUB_CLIENT_ID=

# A client secret you generated on the registration page.
GITHUB_CLIENT_SECRET=

# The private key GitHub generated — the .pem file, and the thing that makes
# this a GitHub App rather than an OAuth app. Paste it with real newlines, with
# \n typed literally, or base64 of the whole file; all three are read.
# It authorizes nothing on its own: an organization that has not installed the
# app is unreachable with it, and one that uninstalls becomes unreachable again.
GITHUB_APP_PRIVATE_KEY=

# What GitHub signs its deliveries with. Typed once into the app's own
# registration — not into every repository, as an OAuth app would have needed.
# The webhook URL is public, so this is the only reason to believe a delivery
# came from GitHub. Generate with:  openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Listen port. The image exposes 8080.
# PORT=8080

# How often to re-read which guilds have this app, in seconds. It is the floor
# under both fast paths: Initiative's lifecycle signal, and GitHub's installation
# webhook. An organization that installs the app after an admin filled the form
# in is picked up here at the latest.
# SYNC_INTERVAL_SECONDS=300

# What `npm run github-app` calls the registration it writes. GitHub App names
# are globally unique, so a second deployment needs a different one.
# GITHUB_APP_NAME=Initiative for GitHub

# For GitHub Enterprise, where the API and the pages a person visits are two
# different hosts. Both must be set together.
# GITHUB_API_BASE=https://github.example.com/api/v3
# GITHUB_WEB_BASE=https://github.example.com
